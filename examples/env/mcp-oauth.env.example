# Example external env file for an OAuth/JWT protected HTTP MCP endpoint.
# Keep this file in plain KEY=VALUE format.

MCP_AUTH_MODE=oauth_jwt
HOST=127.0.0.1
PORT=8787

MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_RESOURCE_IDENTIFIER=https://mcp.example.com/mcp

OAUTH_PROVIDER=generic_oidc
OAUTH_ISSUER=https://issuer.example.com/
OAUTH_AUDIENCE=https://mcp.example.com/mcp
OAUTH_REQUIRED_SCOPES=mcp:read,mcp:command,mcp:write

# Optional explicit JWKS URL.
# OAUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
